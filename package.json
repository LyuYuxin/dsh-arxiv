{
  "name": "dsh-arxiv",
  "version": "0.2.0",
  "description": "arXiv reading as a DeepSeek Harness left-sidebar panel: import by arXiv ID, original text beside AI summary and Q&A, attach the paper to a session so its agent can read it through the arxiv tool.",
  "type": "module",
  "license": "MIT",
  "author": "Lyu Yuxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyuYuxin/dsh-arxiv.git"
  },
  "homepage": "https://github.com/LyuYuxin/dsh-arxiv",
  "bugs": {
    "url": "https://github.com/LyuYuxin/dsh-arxiv/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "arxiv",
    "paper",
    "reading",
    "summary",
    "sidebar",
    "agent"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}

